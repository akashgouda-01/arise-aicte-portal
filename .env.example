# AICTE Approval & Compliance Portal (SIH26262) Environment Configuration

# Server Port
PORT=5000

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# Node Environment
NODE_ENV=development

# Demonstration / Simulation Mode (true enables deterministic in-memory & SQLite seed repository)
DEMO_SIMULATION_MODE=true

# Optional: Supabase Production PostgreSQL Credentials
# If provided, the repository layer automatically connects to Supabase PostgreSQL & Storage
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Optional: Mapbox Geotag Static Tile Token
MAPBOX_ACCESS_TOKEN=
VITE_MAPBOX_ACCESS_TOKEN=
